# ============================================================
# NEURAVEX + CHRONA ENVIRONMENT VARIABLES
# ============================================================

# --- Existing (Neuravex) ---
GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- New (Chrona) ---
# Redis: Get free tier at https://upstash.com
# Create a Redis database → copy REST URL and token
UPSTASH_REDIS_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# Supabase Service Key (for server-side auth validation)
# Found in: Supabase Dashboard → Settings → API → service_role key
# WARNING: This key bypasses RLS — never expose to frontend
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
