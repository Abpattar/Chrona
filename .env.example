# Chrona Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-Key Groq Pool (Workload-separated for zero rate-limit bottlenecks)
GROQ_API_KEY=your_primary_groq_key
GROQ_KEY_CHAT=your_groq_key_1
GROQ_KEY_TRANSITIONS=your_groq_key_2
GROQ_KEY_AGENTS=your_groq_key_3

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Upstash Redis (Optional - falls back to in-memory cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
