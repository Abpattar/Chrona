# Template for local Supabase Edge Function secrets. Copy to `supabase/.env.local` and fill in
# real values. `supabase/.env.local` is git-ignored and must never be committed.
#
# At least one API key is required. Providers are tried in this order; the ones without a key are
# skipped: GroqCloud (primary) -> Gemini (fallback) -> OpenRouter (final fallback).
#
# Model values are optional; the defaults shown are used when unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
