<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Chrona is local-first. P01 declared no runtime permissions at all.

        P03 adds exactly one, at the point of use: the microphone for explicit
        tap-to-speak capture. There is still no android.permission.INTERNET, so no
        component — including any speech recogniser — can open a socket. Notifications (P06)
        and overlay (P06) are added by the phase that owns them.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        P06 reminders. POST_NOTIFICATIONS is requested at the point of use on API 33+;
        SYSTEM_ALERT_WINDOW is the special access for the *optional* floating Quest Card, requested
        only after the user turns the overlay on. Chrona still declares no INTERNET permission, so
        not even a reminder can open a socket.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ChronaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chrona">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chrona">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quest Card actions tapped on a notification. Not exported: only Chrona's own
             PendingIntents target it. -->
        <receiver
            android:name=".platform.notification.ReminderActionReceiver"
            android:exported="false" />
    </application>

</manifest>