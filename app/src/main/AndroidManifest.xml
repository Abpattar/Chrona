<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Chrona is local-first. P01 declared no runtime permissions at all.

        P03 adds exactly one, at the point of use: the microphone for explicit
        tap-to-speak capture. Notifications (P06) and overlay (P06) are added by the phase that
        owns them.

        Cloud task-understanding is the first and only feature that may open a socket. INTERNET is
        declared here but the path is off unless the build is explicitly configured
        (BuildConfig.CLOUD_ENABLED plus a function URL). The device never calls an AI provider
        directly: it calls Chrona's own Supabase Edge Function, and if that call fails or times out
        the deterministic parser takes over. No text leaves the device unless the owner turns the
        feature on.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        P06 reminders. POST_NOTIFICATIONS is requested at the point of use on API 33+;
        SYSTEM_ALERT_WINDOW is the special access for the *optional* floating Quest Card, requested
        only after the user turns the overlay on.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ChronaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chrona">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chrona">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quest Card actions tapped on a notification. Not exported: only Chrona's own
             PendingIntents target it. -->
        <receiver
            android:name=".platform.notification.ReminderActionReceiver"
            android:exported="false" />
    </application>

</manifest>